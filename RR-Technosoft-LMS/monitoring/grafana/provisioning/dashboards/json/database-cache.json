{
  "title": "RR Technosoft LMS \u2014 Database & Cache",
  "uid": "rr-lms-database-cache",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Postgres Up",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "pg_up{job=\"postgres\"}",
          "legendFormat": "up"
        }
      ]
    },
    {
      "id": 2,
      "title": "Redis Up",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "redis_up{job=\"redis\"}",
          "legendFormat": "up"
        }
      ]
    },
    {
      "id": 3,
      "title": "Postgres Active Connections",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(pg_stat_database_numbackends{job=\"postgres\"})",
          "legendFormat": "active connections"
        },
        {
          "expr": "pg_settings_max_connections{job=\"postgres\"}",
          "legendFormat": "max_connections"
        }
      ]
    },
    {
      "id": 4,
      "title": "Postgres Transaction Rate (commits/s vs rollbacks/s)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_xact_commit{job=\"postgres\"}[5m]))",
          "legendFormat": "commits/s"
        },
        {
          "expr": "sum(rate(pg_stat_database_xact_rollback{job=\"postgres\"}[5m]))",
          "legendFormat": "rollbacks/s"
        }
      ]
    },
    {
      "id": 5,
      "title": "Postgres Database Size",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "pg_database_size_bytes{job=\"postgres\", datname=\"rr_lms\"}",
          "legendFormat": "{{datname}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Postgres Cache Hit Ratio",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_blks_hit{job=\"postgres\"}[5m])) / (sum(rate(pg_stat_database_blks_hit{job=\"postgres\"}[5m])) + sum(rate(pg_stat_database_blks_read{job=\"postgres\"}[5m])))",
          "legendFormat": "cache hit ratio"
        }
      ]
    },
    {
      "id": 7,
      "title": "Redis Connected Clients",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "redis_connected_clients{job=\"redis\"}",
          "legendFormat": "clients"
        }
      ]
    },
    {
      "id": 8,
      "title": "Redis Memory Used",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "redis_memory_used_bytes{job=\"redis\"}",
          "legendFormat": "used memory (bytes)"
        }
      ]
    },
    {
      "id": 9,
      "title": "Redis Ops/sec (commands processed)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "rate(redis_commands_processed_total{job=\"redis\"}[5m])",
          "legendFormat": "commands/s"
        }
      ]
    },
    {
      "id": 10,
      "title": "Redis Hit Rate (keyspace hits vs misses)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "expr": "rate(redis_keyspace_hits_total{job=\"redis\"}[5m]) / (rate(redis_keyspace_hits_total{job=\"redis\"}[5m]) + rate(redis_keyspace_misses_total{job=\"redis\"}[5m]))",
          "legendFormat": "hit rate"
        }
      ]
    },
    {
      "id": 11,
      "title": "Redis Evicted / Expired Keys",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "expr": "rate(redis_evicted_keys_total{job=\"redis\"}[5m])",
          "legendFormat": "evicted/s"
        },
        {
          "expr": "rate(redis_expired_keys_total{job=\"redis\"}[5m])",
          "legendFormat": "expired/s"
        }
      ]
    }
  ]
}
