# RR Technosoft LMS — Docker environment
#
# Copy this file to `.env` in the repo root and fill in real values before
# running `./docker/run.sh`. Variables marked REQUIRED have no safe default
# and the script will refuse to start the affected container without them.

# ---------------------------------------------------------------------------
# Database (Postgres)
# ---------------------------------------------------------------------------
DB_NAME=rr_lms
DB_USERNAME=lms_user
DB_PASSWORD=change-me                      # REQUIRED

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Backend / Spring Boot
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=replace-with-a-random-256-bit-secret   # REQUIRED — e.g. `openssl rand -base64 48`
JWT_ACCESS_EXPIRY=900000                    # 15 minutes, in ms
JWT_REFRESH_EXPIRY=604800000                # 7 days, in ms
CORS_ORIGINS=http://localhost:3000

# First-run seed data (super admin account + demo data). Set to false once
# the platform is live and you don't want the seeder running on every restart.
SEED_DATA=true
SUPER_ADMIN_EMAIL=superadmin@rrtechnosoft.com
SUPER_ADMIN_PASSWORD=change-me              # REQUIRED

# Populates a full demo dataset (admin, students, courses, enrollments,
# daily tasks, practice problems, fee records, notifications, a chatbot
# conversation) so a fresh environment is immediately browsable — see
# DemoDataSeeder. Local dev/demo only — leave false in production.
SEED_DEMO_DATA=true

# ---------------------------------------------------------------------------
# Email (SMTP) — used for notifications, password resets, receipts
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@rrtechnosoft.com
MAIL_FROM_NAME="RR Technosoft LMS"

# ---------------------------------------------------------------------------
# WhatsApp notifications (Twilio) — optional
# ---------------------------------------------------------------------------
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ---------------------------------------------------------------------------
# Razorpay (Finance module payment gateway) — optional
# ---------------------------------------------------------------------------
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AI Assistant chatbot — optional. Leave CHATBOT_ENABLED=false to use the
# built-in simulated responses (no external calls); set to true and provide
# an API key to use a real OpenAI-compatible provider.
# ---------------------------------------------------------------------------
CHATBOT_ENABLED=false
CHATBOT_API_KEY=
CHATBOT_BASE_URL=https://api.openai.com/v1
CHATBOT_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# S3-compatible object storage — optional (used for video/PDF uploads)
# ---------------------------------------------------------------------------
S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# ---------------------------------------------------------------------------
# Monitoring (Grafana)
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me            # REQUIRED
